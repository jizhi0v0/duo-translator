<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	M5 (iCloud sync) — uncomment once the App ID has the iCloud capability and
	Development / Developer ID provisioning profiles are in place. Without an
	embedded profile these restricted entitlements make signing/launch fail.

	<key>com.apple.developer.ubiquity-kvstore-identifier</key>
	<string>$(TeamIdentifierPrefix)$(CFBundleIdentifier)</string>
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)dev.bobby.DuoTranslator</string>
	</array>
	-->
</dict>
</plist>
